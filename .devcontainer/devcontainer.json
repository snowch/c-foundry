{
  "name": "C Foundry \u2014 native C lab",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "npm ci && make check-native",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "C Foundry (make serve)",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "docs/codespaces.md"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
