{
  "hello": [
    {
      "name": "Print the greeting",
      "input": "",
      "expected": "Hello, C!"
    }
  ],
  "loops": [
    {
      "name": "Five integers",
      "input": "5",
      "expected": "15"
    },
    {
      "name": "Empty sum",
      "input": "0",
      "expected": "0"
    },
    {
      "name": "One hundred integers",
      "input": "100",
      "expected": "5050"
    }
  ],
  "pointers": [
    {
      "name": "Two different values",
      "input": "10 42",
      "expected": "42 10"
    },
    {
      "name": "Negative values",
      "input": "-7 3",
      "expected": "3 -7"
    },
    {
      "name": "Equal values",
      "input": "8 8",
      "expected": "8 8"
    }
  ],
  "heap": [
    {
      "name": "Five squares",
      "input": "5",
      "expected": "1 4 9 16 25"
    },
    {
      "name": "One square",
      "input": "1",
      "expected": "1"
    },
    {
      "name": "Three squares",
      "input": "3",
      "expected": "1 4 9"
    }
  ],
  "search": [
    {
      "name": "Middle value",
      "input": "23",
      "expected": "5"
    },
    {
      "name": "First element",
      "input": "2",
      "expected": "0"
    },
    {
      "name": "Last element",
      "input": "56",
      "expected": "7"
    },
    {
      "name": "Missing value",
      "input": "13",
      "expected": "-1"
    }
  ],
  "sort": [
    {
      "name": "Unsorted input",
      "input": "5 9 2 7 1 5",
      "expected": "1 2 5 7 9"
    },
    {
      "name": "Duplicates and negatives",
      "input": "5 3 -1 3 0 -1",
      "expected": "-1 -1 0 3 3"
    },
    {
      "name": "One element",
      "input": "1 8",
      "expected": "8"
    }
  ],
  "rows": [
    {
      "name": "First row",
      "input": "1 Ada",
      "expected": "1 | Ada"
    },
    {
      "name": "Another row",
      "input": "42 Grace",
      "expected": "42 | Grace"
    }
  ],
  "query": [
    {
      "name": "Insert and select",
      "input": "insert 1 Ada\nselect 1",
      "expected": "inserted\n1 | Ada"
    },
    {
      "name": "Missing row",
      "input": "select 99",
      "expected": "not found"
    },
    {
      "name": "Reject duplicate IDs",
      "input": "insert 1 Ada\ninsert 1 Grace\nselect 1",
      "expected": "inserted\nduplicate id\n1 | Ada"
    },
    {
      "name": "Find a later row",
      "input": "insert 1 Ada\ninsert 2 Grace\nselect 2",
      "expected": "inserted\ninserted\n2 | Grace"
    }
  ],
  "numbers": [
    {
      "name": "Integer total and fractional share",
      "input": "",
      "expected": "28 3.5"
    }
  ],
  "guess": [
    {
      "name": "Higher, lower, correct",
      "input": "2 9 7",
      "expected": "higher\nlower\ncorrect"
    },
    {
      "name": "Correct first guess",
      "input": "7 1",
      "expected": "correct"
    },
    {
      "name": "Range checks then correct",
      "input": "0 11 7",
      "expected": "out of range\nout of range\ncorrect"
    },
    {
      "name": "End of input",
      "input": "2",
      "expected": "higher\nno more guesses"
    },
    {
      "name": "No guesses",
      "input": "",
      "expected": "no more guesses"
    },
    {
      "name": "Invalid token",
      "input": "x",
      "expected": "invalid input"
    },
    {
      "name": "Range boundaries",
      "input": "1 10 7",
      "expected": "higher\nlower\ncorrect"
    }
  ],
  "functions": [
    {
      "name": "Rectangle",
      "input": "3 4",
      "expected": "12 14"
    },
    {
      "name": "Smallest dimensions",
      "input": "1 1",
      "expected": "1 4"
    },
    {
      "name": "Largest dimensions",
      "input": "100 100",
      "expected": "10000 400"
    },
    {
      "name": "Unequal sides",
      "input": "2 9",
      "expected": "18 22"
    },
    {
      "name": "Invalid dimension",
      "input": "0 4",
      "expected": "invalid"
    },
    {
      "name": "Missing input",
      "input": "",
      "expected": "invalid"
    }
  ],
  "textstats": [
    {
      "name": "Three words",
      "input": "C is fun\n",
      "expected": "8 3"
    },
    {
      "name": "Repeated and edge spaces",
      "input": "  hi  C  \n",
      "expected": "9 2"
    },
    {
      "name": "Tab separators",
      "input": "\tC\tlab\n",
      "expected": "6 2"
    },
    {
      "name": "Whitespace only",
      "input": " \t \n",
      "expected": "3 0"
    },
    {
      "name": "Empty input",
      "input": "",
      "expected": "0 0"
    },
    {
      "name": "Line without final newline",
      "input": "abc",
      "expected": "3 1"
    }
  ]
}
