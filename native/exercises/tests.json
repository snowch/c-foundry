{
  "hello": [
    {
      "name": "Print the greeting",
      "input": "",
      "expected": "Hello, C!"
    }
  ],
  "loops": [
    {
      "name": "Five integers",
      "input": "5",
      "expected": "15"
    },
    {
      "name": "Empty sum",
      "input": "0",
      "expected": "0"
    },
    {
      "name": "One hundred integers",
      "input": "100",
      "expected": "5050"
    }
  ],
  "pointers": [
    {
      "name": "Two different values",
      "input": "10 42",
      "expected": "42 10"
    },
    {
      "name": "Negative values",
      "input": "-7 3",
      "expected": "3 -7"
    },
    {
      "name": "Equal values",
      "input": "8 8",
      "expected": "8 8"
    }
  ],
  "heap": [
    {
      "name": "Five squares",
      "input": "5",
      "expected": "1 4 9 16 25"
    },
    {
      "name": "One square",
      "input": "1",
      "expected": "1"
    },
    {
      "name": "Three squares",
      "input": "3",
      "expected": "1 4 9"
    }
  ],
  "search": [
    {
      "name": "Middle value",
      "input": "23",
      "expected": "5"
    },
    {
      "name": "First element",
      "input": "2",
      "expected": "0"
    },
    {
      "name": "Last element",
      "input": "56",
      "expected": "7"
    },
    {
      "name": "Missing value",
      "input": "13",
      "expected": "-1"
    }
  ],
  "sort": [
    {
      "name": "Unsorted input",
      "input": "5 9 2 7 1 5",
      "expected": "1 2 5 7 9"
    },
    {
      "name": "Duplicates and negatives",
      "input": "5 3 -1 3 0 -1",
      "expected": "-1 -1 0 3 3"
    },
    {
      "name": "One element",
      "input": "1 8",
      "expected": "8"
    }
  ],
  "rows": [
    {
      "name": "First row",
      "input": "1 Ada",
      "expected": "1 | Ada"
    },
    {
      "name": "Another row",
      "input": "42 Grace",
      "expected": "42 | Grace"
    }
  ],
  "query": [
    {
      "name": "Insert and select",
      "input": "insert 1 Ada\nselect 1",
      "expected": "inserted\n1 | Ada"
    },
    {
      "name": "Missing row",
      "input": "select 99",
      "expected": "not found"
    },
    {
      "name": "Reject duplicate IDs",
      "input": "insert 1 Ada\ninsert 1 Grace\nselect 1",
      "expected": "inserted\nduplicate id\n1 | Ada"
    },
    {
      "name": "Find a later row",
      "input": "insert 1 Ada\ninsert 2 Grace\nselect 2",
      "expected": "inserted\ninserted\n2 | Grace"
    }
  ]
}
